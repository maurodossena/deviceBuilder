&GLOBAL
        PROJECT cp2k_relax
        RUN_TYPE ENERGY
        PRINT_LEVEL MEDIUM
        EXTENDED_FFT_LENGTHS
        PREFERRED_DIAG_LIBRARY SL
&END GLOBAL
&MOTION
        &GEO_OPT #basically default setting
                &BFGS
                        TRUST_RADIUS 0.1
                &END BFGS
                OPTIMIZER BFGS
                MAX_ITER 200
                !STEP_START_VAL0
                TYPE MINIMIZATION
                !EXTERNAL_PRESSURE 0
                !PRESSURE_TOLERANCE 100
                !MAX_DR    1.0E-03
                !MAX_FORCE 1.0E-04
                !RMS_DR    0.5E-03
                !RMS_FORCE 0.5E-04

        &END GEO_OPT
        &CELL_OPT
                MAX_ITER 50 # changed from 10 originally
                KEEP_SYMMETRY
                CONSTRAINT Z
        &END
        &CONSTRAINT
        &END CONSTRAINT
        &PRINT
                &TRAJECTORY
                        ADD_LAST SYMBOLIC
                        &EACH
                                CELL_OPT 0 
                                GEO_OPT 0
                                QS_SCF 0
                        &END EACH
                        PRINT_ATOM_KIND
                &END TRAJECTORY
        &END PRINT
&END MOTION
&FORCE_EVAL
        METHOD QS
        STRESS_TENSOR ANALYTICAL
        &SUBSYS
                &CELL
                        ABC 2.4612 4.26292 20
                        ALPHA_BETA_GAMMA 90 90 90
                        MULTIPLE_UNIT_CELL 1 1 1
                        SYMMETRY ORTHORHOMBIC
                &END CELL
                &topology
                        MULTIPLE_UNIT_CELL 1 1 1
                        COORD_FILE_NAME graphene.xyz
                        COORD_FILE_FORMAT XYZ
                &end
                ! SZV is a very small basis that should never really be used
                ! except after throrough testing, i.e. the electronic structure
                ! around the fermi energy is often usefull even with SZV
                ! the forces however are almost always useless.
                ! 
                ! Different basis sets should not be mixed, e.g. stick with SR for all elements
                ! SR ensures that the overlap matrix is well conditioned in condensed systems.

                &KIND C
                        BASIS_SET DZVP-MOLOPT-SR-GTH-q4
                        POTENTIAL GTH-PBE-q4
                &END KIND
        &END SUBSYS
        &DFT
                !MULTIPLICITY 2
                CHARGE 0
                BASIS_SET_FILE_NAME BASIS_MOLOPT
                POTENTIAL_FILE_NAME GTH_POTENTIALS
                &QS
                        METHOD GPW
                        !EPS_DEFAULT 0.00005
                        EPS_DEFAULT 1e-16 ! should not be increased 
                        !EPS_PGF_ORB 1E-10
                &END QS
                &MGRID
                        NGRIDS 4
                        CUTOFF 1400
                        REL_CUTOFF 80
                &END MGRID
                !WFN_RESTART_FILE_NAME cp2k_relax-RESTART.wfn
                &SCF
                        !EPS_SCF 0.001
                        EPS_SCF 1e-10 ! should not be larger
                        SCF_GUESS RESTART
                        !&OT
                        !        !PRECONDITIONER FULL_ALL
                        !       PRECONDITIONER FULL_SINGLE_INVERSE
                        !        ENERGY_GAP 0.1
                        !        ALGORITHM IRAC
                        !        MINIMIZER DIIS
                        !&END OT
                        !&OUTER_SCF
                        !        EPS_SCF 1e-8 ! should match the one above
                        !        MAX_SCF 8
                        !&END OUTER_SCF
                       MAX_SCF 1000
                       ADDED_MOS 50
                       &DIAGONALIZATION T
                               ALGORITHM STANDARD
                       &END DIAGONALIZATION
                       &MIXING
                               METHOD BROYDEN_MIXING
                               ALPHA 0.1
                               BETA 0.2
                               NBUFFER 8
                       &END MIXING
               &END SCF
               &XC
                       &XC_FUNCTIONAL
                               &PBE
                               &END
                       &END XC_FUNCTIONAL
               &END XC
               &KPOINTS
                       SCHEME MONKHORST-PACK 13 13 1
               &END
               &PRINT
                       &BAND_STRUCTURE
                               FILE_NAME bands.dat
                               &KPOINT_SET
                                       SPECIAL_POINT GAMMA -0.5 0 0
                                       SPECIAL_POINT GAMMA 0 0 0
                                       SPECIAL_POINT GAMMA 0.5 0 0
                                       NPOINTS 20
                               &END
                       &END
                       &KS_CSR_WRITE
                               BINARY
                               REAL_SPACE
                               THRESHOLD 1e-6
                       &END
                       &S_CSR_WRITE
                               BINARY
                               REAL_SPACE
                               THRESHOLD 1e-6
                       &END
                       &MO
                               ADD_LAST SYMBOLIC
                               ENERGIES
                               &EACH
                                       QS_SCF 0
                               &END
                       &END
               &END
       &END DFT
       !&PRINT
       !    &FORCES ON
       !    &END FORCES
       !&END PRINT
&END FORCE_EVAL
